datasource db {
  provider  = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum PlanTier {
  FREE
  PRO
  ENTERPRISE
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
  URGENT
}

enum Category {
  BILLING
  BUG
  FEATURE_REQUEST
  OUTAGE
  GENERAL_INQUIRY
}

model Ticket {
  // id           String    @id @default(uuid())
  id           String    @id @default(dbgenerated("gen_random_uuid()"))
  customerId   String
  ticketBody   String
  planTier     PlanTier  @default(FREE)
  isPriority   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  status      String   @default("PENDING_ANALYSIS")

  analysis     Analysis?
}

model Analysis {
  id           String    @id @default(uuid())
  ticketId     String    @unique
  ticket       Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  sentiment    Sentiment
  category     Category
  urgencyScore Int
  summary      String
  processedAt  DateTime  @default(now())

  isPriorityFlagged Boolean  @default(false) // New field to indicate if the ticket is flagged as priority by system
  tags         String[]  // PostgreSQL array of strings to store tags
}